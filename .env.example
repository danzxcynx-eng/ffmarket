# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ffmarket"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Owner/Admin Account (Only this email has admin role)
OWNER_EMAIL="admin@ffmarket.com"
OWNER_PASSWORD_HASH=""

# Payment Gateway (Ready for integration)
QRIS_MERCHANT_ID=""
QRIS_API_KEY=""
VA_MERCHANT_ID=""
VA_API_KEY=""

# Email Service
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Encryption Key for sensitive data
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# App Configuration
NODE_ENV="development"
APP_NAME="FFMARKET"
APP_URL="http://localhost:3000"

# Order Configuration
ORDER_CONFIRMATION_TIMEOUT_HOURS=24
ORDER_AUTO_COMPLETE_HOURS=48
